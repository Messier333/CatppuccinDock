POSTGRES_DB=catppuccindock
POSTGRES_USER=catppuccindock
POSTGRES_PASSWORD=
ADMIN_SETUP_CODE=
PORTAL_PORT=8090
# HTTPS로 서비스할 때 true로 설정합니다.
COOKIE_SECURE=false
# README의 OpenSSL 명령으로 빈 시크릿을 생성하거나 외부 저장소에서 주입합니다.
# 2FA·SSO·API 토큰 암호화 키입니다. 설정 후 교체하지 말고 DB 백업과 함께 보관하세요.
AUTH_ENCRYPTION_KEY=
# OIDC와 리버스 프록시 API는 관리자 페이지에서 등록합니다.

# 스토리지 키 생성 형식: docs/secrets.md를 참고하세요.
MEDIA_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_BUCKET=catppuccindock
S3_KEY_PREFIX=catppuccindock
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=

# 기본 Compose는 GHCR 이미지를 사용합니다. 포크는 소문자로 변경하세요.
GHCR_IMAGE_PREFIX=ghcr.io/messier333/catppuccindock
IMAGE_TAG=latest
