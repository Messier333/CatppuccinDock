# Copy to the host's /etc/fail2ban/jail.d/ after replacing the logpath and checking the firewall chain.
# Find the auth_logs mountpoint with the command in docs/authentication.md.
[catppuccindock]
enabled = true
filter = catppuccindock
logpath = /var/lib/docker/volumes/REPLACE_WITH_AUTH_LOG_VOLUME/_data/auth.log
backend = polling
usedns = no
logtimezone = UTC
findtime = 15m
maxretry = 5
bantime = 1h
# Docker published ports traverse DOCKER-USER, not the host INPUT chain.
# Check this chain exists on the Docker host before enabling this example.
banaction = iptables-allports
chain = DOCKER-USER
